DATABASE_URL=postgresql+psycopg://pharmacy:YOUR_DATABASE_PASSWORD@localhost:5432/pharmacy
SECRET_KEY=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite
GEMINI_RETRY_ATTEMPTS=1

# Gemini -> Groq. Add GROQ_API_KEY to backend/.env, never to frontend or GitHub.
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
AI_ENABLE_GROQ_FALLBACK=true
AI_STREAM_READ_TIMEOUT_SECONDS=30
AI_GEMINI_FAILOVER_BUDGET_SECONDS=20
